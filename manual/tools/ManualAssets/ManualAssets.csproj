<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.31</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenKh.Egs"><HintPath>../../../build/vendor/manual-openkh/OpenKh.Egs.dll</HintPath></Reference>
    <Reference Include="OpenKh.Common"><HintPath>../../../build/vendor/manual-openkh/OpenKh.Common.dll</HintPath></Reference>
    <Reference Include="Xe.BinaryMapper"><HintPath>../../../build/vendor/manual-openkh/Xe.BinaryMapper.dll</HintPath></Reference>
  </ItemGroup>
</Project>
